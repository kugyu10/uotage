{
  "name": "uotage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test --experimental-strip-types",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe.mjs",
    "probe:vercel": "node scripts/probe.mjs --vercel",
