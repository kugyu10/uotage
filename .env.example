# =============================================================================
# uotage / 環境変数テンプレート
#
# 使い方: cp .env.example .env.local して値を埋める。
#         埋めたら `npm run probe` で疎通と認証を確認する。
#
# 命名は要件定義書 2章のアーキテクチャに対応。
# NEXT_PUBLIC_ が付くものだけがブラウザに露出する。それ以外は絶対に露出させない。
# =============================================================================

# -----------------------------------------------------------------------------
# アプリ本体
# -----------------------------------------------------------------------------
# 本番の公開URL。メール内のリンク（プレゼントDL・メルマガ解除・オファーページ）の
# 組み立てに使うので、ローカルでも実在するURLを入れておく。
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 登録ページに表示する特定電子メール法・プライバシーポリシー用の連絡先。
# 配信開始前に実在の情報へ必ず置き換える。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# -----------------------------------------------------------------------------
# Supabase
#   取得元: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------
# プロジェクトURL (例: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# anon (publishable) キー。ブラウザに露出してよい。RLS が効いている前提。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role キー。★サーバーサイド専用。RLS を全て貫通するので絶対に露出させない。
# 要件定義書 6.1 の通り、Route Handler / Edge Function からのみ使う。
SUPABASE_SERVICE_ROLE_KEY=
# プロジェクト ref (URL のサブドメイン部分)。supabase CLI のリンクに使う。
SUPABASE_PROJECT_REF=
# Phase 1 で作成した自分用テナントの UUID。公開登録フォームが参照する
# ファネルをこのテナントに限定するために使用する。
DEFAULT_TENANT_ID=

# -----------------------------------------------------------------------------
# Resend
#   取得元: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# 任意: ローカルの npm run probe で送信ドメインの状態まで検査するための
# Full access キー。本番/Vercel には設定しない（RESEND_API_KEY は送信専用でよい）。
RESEND_PROBE_API_KEY=
# 差出人アドレス。★このドメインは Resend で SPF/DKIM/DMARC 認証済みである必要がある。
# 未認証のまま送るとステップ配信は高確率で迷惑メール送りになる（要件定義書 6.2）。
RESEND_FROM_EMAIL=
# 差出人表示名 (例: 山田太郎)
RESEND_FROM_NAME=

# -----------------------------------------------------------------------------
# Stripe
#   取得元: https://dashboard.stripe.com/test/apikeys
#   MVP 中は必ずテストキー (sk_test_ / pk_test_) を使う。
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook 署名シークレット (whsec_...)。
# ローカルでは `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する値。
# 本番では Dashboard > Developers > Webhooks で作成したエンドポイントの値。
# 要件定義書 4.3 の通り、署名検証は必須。
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 配信ワーカー（Supabase Edge Function dispatch-deliveries）
# -----------------------------------------------------------------------------
# 本番の公開 URL。メール本文のオファー・解除リンクを生成する。
APP_URL=https://your-production-domain.example
# `npm run deliveries:deploy` は本番用の値を生成し、Edge Function と
# Supabase Vault の両方へ同期する。ローカル実行時だけ必要なら設定する。
CRON_SECRET=

# -----------------------------------------------------------------------------
# 外部予約ツール（個別相談）
#   TimeRex / Calendly / Spir 等。本ツールは「期限で開閉する」だけで、
#   日程調整そのものは外部に委譲する（要件定義書 1.6）。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BOOKING_URL=
